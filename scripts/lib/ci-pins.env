# CI pin manifest — single source for reproducible selfhost/runtime builds.
# Ubuntu: GitHub-hosted LTS runner (not ubuntu-latest).
# Node: patch + official bookworm image (sync scripts/bootstrap/linux.sh OPPTRIX_NODE_VERSION).

CI_UBUNTU_RUNNER=ubuntu-24.04
OPPTRIX_NODE_PATCH_VERSION=24.11.1
CI_NODE_BOOKWORM_IMAGE=node:24.11.1-bookworm
