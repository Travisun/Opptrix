# CI pin manifest — single source for reproducible selfhost/runtime builds.
# Ubuntu: GitHub-hosted LTS runner (not ubuntu-latest).
# Node: patch + official bookworm image (sync scripts/bootstrap/linux.sh OPPTRIX_NODE_VERSION).
# Docker Hub images below are for GitHub CI (NODE_IMAGE_PREFIX= empty in workflows).
# CN local builds use NODE_IMAGE_PREFIX=docker.1ms.run/library/ (Hub library/ proxy; not amd64/).
# Docker runtime: Debian bookworm apt for ffmpeg/python; rebuild image to pick up security updates.

CI_UBUNTU_RUNNER=ubuntu-24.04
OPPTRIX_NODE_PATCH_VERSION=24.11.1
CI_NODE_BOOKWORM_IMAGE=node:24.11.1-bookworm
CI_NODE_BOOKWORM_SLIM_IMAGE=node:24.11.1-bookworm-slim
DOCKER_DEBIAN_SUITE=bookworm
DOCKER_NVM_INSTALL_TAG=v0.40.2
DOCKER_NVM_NODE_22_TRACK=22
DOCKER_FFMPEG_PATH=/usr/bin/ffmpeg
DOCKER_PLAYWRIGHT_BROWSERS_PATH=/opt/opptrix/playwright-browsers
