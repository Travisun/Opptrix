{
  "name": "opptrix",
  "private": true,
  "description": "Opptrix — 面向个人投资者的多市场投研数据助手（Web + Electron 桌面端）",
  "homepage": "https://www.opptrix.org",
  "license": "Apache-2.0",
  "author": "Opptrix contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Travisun/Opptrix.git"
  },
  "bugs": {
    "url": "https://github.com/Travisun/Opptrix/issues"
  },
  "keywords": [
    "opptrix",
    "investment-research",
    "stock",
    "a-share",
    "agent",
    "electron",
    "fastify",
    "react"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "client-ui"
  ],
  "scripts": {
    "dev": "node scripts/dev-with-ports.mjs",
    "dev:desktop": "npm run build:packages && npm run dev -w @opptrix/desktop",
    "dev:api": "npm run dev -w @opptrix/server",
    "dev:web": "npm run dev -w opptrix-client",
    "prepare:fonts": "node scripts/prepare-ui-fonts.mjs",
    "build": "npm run build:packages && npm run prepare:fonts && npm run build -w opptrix-client",
    "build:desktop": "npm run build -w @opptrix/desktop",
    "build:packages": "node scripts/ensure-dev-deps.mjs && npm run build -w @opptrix/shared -w @opptrix/canvas -w @opptrix/user-store -w @opptrix/doc-library -w @opptrix/schedule -w @opptrix/local-inference -w @opptrix/market-data-core -w @opptrix/a-stock-layer -w @opptrix/news-feed -w @opptrix/article-enrichment -w @opptrix/provider-sdk -w @opptrix/market-data-providers-cn -w @opptrix/market-data-providers-us -w @opptrix/market-data-providers-crypto -w @opptrix/stock-eval -w @opptrix/market-data-store -w @opptrix/institutions -w @opptrix/t-strategy -w @opptrix/research-hub -w @opptrix/agent-browser -w @opptrix/agent-workspace -w @opptrix/agent-skills -w @opptrix/agent -w @opptrix/search-hub -w @opptrix/server",
    "typecheck:ui": "tsc -p client-ui/tsconfig.json --noEmit",
    "lint:ui": "eslint client-ui/src --max-warnings 9999 --quiet",
    "audit:ui": "node scripts/audit-client-ui-react.mjs",
    "check:ui": "node scripts/check-client-ui.mjs",
    "release:notes": "node scripts/assemble-release-notes.mjs",
    "optimize:sponsors": "node scripts/optimize-sponsor-images.mjs",
    "start": "npm run start -w @opptrix/server",
    "serve": "concurrently -k -n api,web -c blue,cyan \"npm run start\" \"npm run preview -w opptrix-client -- --host 0.0.0.0\"",
    "clean": "find packages apps -name dist -type d -prune -exec rm -rf {} + 2>/dev/null; find packages apps -name tsconfig.tsbuildinfo -delete 2>/dev/null; rm -rf client-ui/dist",
    "test": "npm run build:packages && node scripts/run-tests.mjs",
    "test:ci": "node scripts/run-tests.mjs",
    "test:live-network": "OPPTRIX_LIVE_NETWORK_TESTS=1 node scripts/run-tests.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.13.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "apache-arrow": "^21.1.0",
    "sharp": "0.35.3"
  },
  "overrides": {
    "tar": "^7.5.22",
    "node-gyp": "^12.4.0",
    "find-my-way": "9.7.0",
    "fast-uri@3": "3.1.5",
    "fast-uri@4": "4.1.2",
    "dompurify": "^3.4.13",
    "hono": "^4.13.1",
    "@hono/node-server": "^1.19.15",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@4": "4.0.1",
    "brace-expansion@5": "5.0.9",
    "undici": "^7.29.0",
    "js-yaml": "^4.3.1",
    "ip-address": "^10.5.0",
    "nanoid@3": "3.3.18",
    "postcss": "^8.5.26",
    "sharp": "$sharp",
    "@gutenye/ocr-node": {
      "sharp": "$sharp"
    },
    "@huggingface/transformers": {
      "sharp": "$sharp"
    },
    "@lancedb/lancedb": {
      "sharp": "$sharp",
      "@huggingface/transformers": {
        "sharp": "$sharp"
      }
    }
  },
  "allowScripts": {
    "better-sqlite3": true,
    "duckdb": true,
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "ffmpeg-static": true,
    "node-llama-cpp": true,
    "fsevents": true,
    "sharp": true
  }
}
