{
  "name": "@opptrix/agent-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "builtin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(({cpSync})=>cpSync('builtin','dist/builtin',{recursive:true}))\""
  },
  "dependencies": {
    "@opptrix/shared": "*"
  }
}
